*.host_key

# ── ANDROIDTUI Android/Termux fork ──────────────────────────────────────────
# Scratch produced by packages/core/scripts/vendor-deps.sh while building
# libopentui.so natively on Termux. Regenerated on every build (~22 MB),
# and machine-specific — never commit it.
.zig-deps/
.zig-linker-stubs/

# Staging dirs for the @androidtui packages, written by
# scripts/androidtui-repackage.mjs and packages/core/scripts/package-prebuilt.ts.
artifacts/
packages/core/dist-prebuilt/

# NOT ignored: packages/core/prebuilt/<arch>/libopentui.so
# That .so is built on-device and committed on purpose — the release
# workflow publishes it rather than cross-compiling.
