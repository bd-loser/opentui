diff --git a/packages/core/scripts/native-abi.ts b/packages/core/scripts/native-abi.ts
index 1d74d4d..e4624d5 100644
--- a/packages/core/scripts/native-abi.ts
+++ b/packages/core/scripts/native-abi.ts
@@ -317,6 +317,15 @@ if (import.meta.main) {
   const args = process.argv.slice(2)
   if (args.some((arg) => arg !== "--check" && arg !== "--all-targets" && arg !== "--audit"))
     throw new Error("Expected --check, --all-targets and/or --audit")
+  // Android (Termux): the ABI audit needs a host clang that resolves libc
+  // headers, and Termux's sys/cdefs.h rejects every triple Zig can emit
+  // ("Unversioned target triples are not supported!"). The .so shipped for
+  // android is built by build-native-termux.sh, whose translate-c steps pin
+  // -D__ANDROID_API__; generated.ts always comes from a supported host.
+  if (process.platform === "android") {
+    console.log("native-abi: skipped on Android host (see packages/core/scripts/native-abi.ts)")
+    process.exit(0)
+  }
   const abi = compileHeader({ allTargets: args.includes("--all-targets") })
   const generated = await generateNativeABI(abi)
   if (args.includes("--check")) verifyNativeABI(generated)
